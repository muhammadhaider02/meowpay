# Copy to .env.local for development. Vercel takes the same three as project
# environment variables.
#
# All three are NEXT_PUBLIC_, which means all three are compiled into the
# JavaScript bundle and are readable by anyone who opens the page. That is
# correct for every value here and for no other value: the publishable key is
# designed to ship in a browser, and the database it reaches is protected by
# row level security plus a schema PostgREST does not expose, not by the key
# being secret.
#
# The secret key (sb_secret_...) is NOT here and must never be. It belongs to
# meowpay-seed, which runs from a developer machine.

# The Supabase project, from the dashboard under Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key, not the secret key. It begins sb_publishable_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Where FastAPI is. No trailing slash. In development this is the local API;
# in production it is the Render service, and that exact origin has to appear
# in the backend's CORS_ORIGINS or every request is refused by the browser
# before it reaches a route.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
