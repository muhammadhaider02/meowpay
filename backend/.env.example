# Copy to backend/.env and fill in. .env is gitignored and must stay that way:
# unlike the previous local stack, these are real credentials to a real project.

# ============================================================
# REQUIRED
# ============================================================

# The Supabase connection string. From the dashboard: Connect -> Direct ->
# Session pooler -> URI. Replace [YOUR-PASSWORD] with the database password.
#
# Three things about this are load bearing.
#
# Port 5432, the SESSION pooler, not 6543. The transaction pooler on 6543 breaks
# three things at once and every one of them is silent: prepared statements
# become intermittent errors under load only, session level settings stop
# applying, and connections are multiplexed so the concurrency tests stop
# actually racing. The app refuses 6543 outright rather than explaining it in a
# comment nobody reads.
#
# Copy the hostname, do not assemble it. Older projects sit behind aws-0-<region>
# and newer ones behind aws-1-<region>. Guessing wrong fails at DNS, which
# produces no SQLSTATE, which the test suite correctly reads as "database
# unreachable" and skips on. A wrong hostname is therefore a green test run that
# tested nothing.
#
# Percent-encode the password if it contains @ : / ? # or %. A raw @ in
# particular will split the URL in the wrong place.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ============================================================
# OPTIONAL (defaults shown, safe to omit entirely)
# ============================================================

# The schema the application's tables live in. Deliberately not `public`:
# Supabase runs PostgREST over public and the publishable key ships in the
# browser bundle, so a table there is reachable by a PATCH that never touches
# the ledger.
DB_SCHEMA=meowpay

# The throwaway database the test suite creates, migrates and drops on every
# run. Defaults to DATABASE_URL with the database name swapped to meowpay_test,
# so there is normally nothing to set here. The suite refuses any name not
# ending in `_test` before it runs a single DROP.
# TEST_DATABASE_URL=

# Set to 1 in CI. Without it an unreachable database SKIPS the suite, which on a
# free-tier Supabase project is a real scenario: projects pause after 7 days of
# inactivity, and a skipped suite looks exactly like a passing one.
# MEOWPAY_REQUIRE_DB=1

# API server. Render sets PORT, so API_PORT is read from it there and API_HOST
# must be 0.0.0.0 rather than the loopback default.
API_HOST=127.0.0.1
API_PORT=8000

# Which browser origins may call this API. The access token travels in an
# Authorization header rather than a cookie, so these are not credentialed
# requests, but an explicit list is free blast radius control. '*' is refused.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
