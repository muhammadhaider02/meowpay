# Copy to backend/.env and fill in. .env is gitignored and must stay that way:
# these are real credentials to a real hosted project, not throwaway local ones.

# ============================================================
# REQUIRED
# ============================================================

# The Supabase connection string. From the dashboard: Connect -> Direct ->
# Session pooler -> URI. Replace [YOUR-PASSWORD] with the database password.
#
# Three things about this are load bearing.
#
# Port 5432, the SESSION pooler, not 6543. The transaction pooler on 6543 breaks
# three things at once and every one of them is silent: prepared statements
# become intermittent errors under load only, session level settings stop
# applying, and connections are multiplexed so the concurrency tests stop
# actually racing. The app refuses 6543 outright rather than explaining it in a
# comment nobody reads.
#
# Copy the hostname, do not assemble it. Older projects sit behind aws-0-<region>
# and newer ones behind aws-1-<region>. Guessing wrong fails at DNS, which
# produces no SQLSTATE, which the test suite correctly reads as "database
# unreachable" and skips on. A wrong hostname is therefore a green test run that
# tested nothing.
#
# Percent-encode the password if it contains @ : / ? # or %. A raw @ in
# particular will split the URL in the wrong place.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# The Supabase project URL, from Connect -> Server, or Project Settings -> API.
# Public: it ships in the browser bundle anyway. Required, because a verifier
# that cannot name its issuer cannot verify anything, and guessing would mean
# accepting tokens from an issuer nobody chose.
SUPABASE_URL=https://<project-ref>.supabase.co

# ============================================================
# REQUIRED BY `make seed` ONLY
# ============================================================

# The service role key (sb_secret_...). It bypasses every row level security
# policy, so it is read by `meowpay-seed` and by nothing else.
#
# Do NOT set this on the deployed API service. The API has no use for it and its
# presence there is a standing privilege escalation risk: anything that can read
# the environment gets unrestricted database access.
SUPABASE_SECRET_KEY=sb_secret_<...>

# ============================================================
# OPTIONAL (defaults shown, safe to omit entirely)
# ============================================================

# Token verification. All derived from SUPABASE_URL, so normally leave them.
# The JWKS endpoint returns no keys at all unless the project uses asymmetric
# signing keys, which is the default for new projects and what this expects.
# Check under Authentication -> JWT signing keys.
# SUPABASE_JWKS_URL=
# SUPABASE_JWT_ISSUER=
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWKS_CACHE_SECONDS=600
# SUPABASE_JWKS_TIMEOUT_SECONDS=3

# The demo password and email domain `make seed` uses. .test is reserved by
# RFC 2606 and can never resolve, so a misconfigured SMTP server cannot deliver
# a sign-up mail to a real inbox.
# SEED_PASSWORD=treats123
# SEED_EMAIL_DOMAIN=meowpay.test

# The schema the application's tables live in. Deliberately not `public`:
# Supabase runs PostgREST over public and the publishable key ships in the
# browser bundle, so a table there is reachable by a PATCH that never touches
# the ledger.
DB_SCHEMA=meowpay

# The throwaway database the test suite creates, migrates and drops on every
# run. Defaults to DATABASE_URL with the database name swapped to meowpay_test,
# so there is normally nothing to set here. The suite refuses any name not
# ending in `_test` before it runs a single DROP.
# TEST_DATABASE_URL=

# Set to 1 wherever the suite runs unattended. Without it an unreachable database
# SKIPS the suite, which on a free-tier Supabase project is a real scenario:
# projects pause after 7 days of inactivity, and a skipped suite looks exactly
# like a passing one.
# MEOWPAY_REQUIRE_DB=1

# API server. Nothing here reads Render's PORT: serve() reads API_PORT and only
# API_PORT, so the start command has to do the mapping itself with
# `API_HOST=0.0.0.0 API_PORT=$PORT uv run --no-sync meowpay-api`. Note that an
# empty PORT would leave API_PORT unset and bind 8000, which Render reports only
# as "no open ports detected".
API_HOST=127.0.0.1
API_PORT=8000

# Which browser origins may call this API. The access token travels in an
# Authorization header rather than a cookie, so these are not credentialed
# requests, but an explicit list is free blast radius control. '*' is refused.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
